# =========================================================================
# PRIME APPAREL B2B ERP - PRODUCTION ENVIRONMENT CONFIGURATION
# =========================================================================

# 1. DATABASE CONFIGURATION (SQLite Fallback vs Production PostgreSQL Migration)
# Standard sqlite local URL: "file:./dev.db"
# Switch schema.prisma provider to "postgresql" and uncomment below for production migration:
DATABASE_URL="postgresql://postgres:yoursecurepassword@localhost:5432/prime_apparel?schema=public"

# 2. CLOUDINARY INTEGRATION (Real image upload system)
# Retrieve these credentials from your Cloudinary console dashboard
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# 3. SECURITY & CRYPTO SECRETS
# Used in unified B2B auth token signing
JWT_SECRET="prime_apparel_super_secure_jwt_secret_key_2026"

# 4. SERVER SYSTEM CONFIG
PORT=3001
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
