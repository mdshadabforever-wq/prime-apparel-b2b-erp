# =========================================================================
# PRIME APPAREL B2B ERP - PRODUCTION ENVIRONMENT CONFIGURATION
# =========================================================================

# 1. DATABASE CONFIGURATION & ENVIRONMENT STRATEGY
#
# Choose your active environment database connection string below.
# Note: Ensure your `prisma/schema.prisma` provider matches the database type!

# --- OPTION A: LOCAL DEVELOPMENT (Default SQLite)
# Provider in schema.prisma must be "sqlite"
# DATABASE_URL="file:./dev.db"

# --- OPTION B: LOCAL POSTGRESQL (Local Docker / Native installation)
# Provider in schema.prisma must be "postgresql"
# DATABASE_URL="postgresql://postgres:yoursecurepassword@localhost:5432/prime_apparel?schema=public"

# --- OPTION C: NEON SERVERLESS POSTGRESQL (Highly Recommended for Development/Staging Cloud)
# Provider in schema.prisma must be "postgresql"
# Neon connection string automatically uses pooled or unpooled connections:
# (Use pooled port 5432 for migrations, and connection pooling / transaction mode for Serverless Next.js functions)
# DATABASE_URL="postgresql://neondb_owner:npg_yourpass@ep-cool-fog-a5m0o9.us-east-2.aws.neon.tech/prime_apparel?sslmode=require"

# --- OPTION D: AWS RDS / GOOGLE CLOUD SQL (Recommended Production setup)
# Provider in schema.prisma must be "postgresql"
# DATABASE_URL="postgresql://db_user:db_password@prime-apparel-rds-instance.crz5e8u9z3.us-east-1.rds.amazonaws.com:5432/prime_apparel?sslmode=require&schema=public"

# --- ACTIVE RUN DATABASE URL (Set this to your target active connection string)
DATABASE_URL="file:./dev.db"


# 2. CLOUDINARY INTEGRATION (Real image upload system)
# Retrieve these credentials from your Cloudinary console dashboard
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"


# 3. SECURITY & CRYPTO SECRETS
# Used in unified B2B auth token signing. Keep this highly secure in production!
JWT_SECRET="prime_apparel_super_secure_jwt_secret_key_2026"


# 4. SERVER SYSTEM CONFIG
PORT=3001
NODE_ENV="development" # Switch to "production" in live host
NEXT_PUBLIC_APP_URL="http://localhost:3001"
